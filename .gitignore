# Secretos y configuracion local
/.env
/.env.*
!/.env.example

# Archivos temporales y logs
/debug_*.txt
/debug_*.log
*.log
/tmp/*
!/tmp/.gitkeep

# Archivos subidos por usuarios (conservar en el servidor)
/uploads/*
!/uploads/.gitkeep
!/uploads/.htaccess
/admin/firmas/tmp/*
!/admin/firmas/tmp/.gitkeep
/backend/twilio_log.txt

# Volcados de base de datos con datos personales/credenciales; conservar solo migraciones versionables.
/sql/*.sql
!/sql/migrations/
/sql/migrations/*.sql
!/sql/migrations/*.sql
